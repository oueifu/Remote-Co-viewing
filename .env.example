# 服务端运行端口（Node 独立运行模式，默认 5050）
PORT=5050

# 桌面客户端自定义端口（Electron 模式默认 5050，启动时会自动同步覆盖子进程 PORT）
# SYNC_CINEMA_PORT=5050

# 服务端监听 IP 地址（默认 127.0.0.1 本地回环；局域网直接联机访问请设置为 0.0.0.0）
# BIND_HOST=127.0.0.1

# [可选] 自定义 mpv 播放器可执行文件的绝对路径。如果已加入 PATH，可保持为空。
# 示例 (Windows): C:\Tools\mpv\mpv.exe
# 示例 (Mac/Linux): /usr/bin/mpv
SYNC_CINEMA_MPV_PATH=
